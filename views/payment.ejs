<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">

  <div class="card shadow-lg border-0 p-4 text-center" style="max-width: 450px; width: 100%; border-radius: 15px;">

    <!-- Title -->
    <h3 class="mb-3 fw-bold">Complete Your Payment 💳</h3>

    <p class="text-muted mb-4">
      Secure payment powered by Razorpay
    </p>

    <!-- Booking Summary -->
    <div class="text-start mb-4 p-3" style="background: #f8f9fa; border-radius: 10px;">
      
      <h5 class="fw-semibold"><%= list.title %></h5>

      <p class="mb-1">
        📅 <%= checkIn %> → <%= checkOut %>
      </p>

      <p class="mb-1">
        👥 Guests: <%= guests %>
      </p>

      <hr>

      <p class="fw-bold fs-5 text-success mb-0">
        Total: ₹<%= total / 100 %>
      </p>
    </div>

    <!-- PAY BUTTON -->
    <button id="payBtn" class="btn btn-success w-100 py-2 fs-5" style="border-radius: 10px;">
      Pay ₹<%= total / 100 %> Now
    </button>

  </div>

</div>

<script>
  const options = {
    key: "<%= process.env.RAZORPAY_KEY_ID %>",
    amount: "<%= order.amount %>",
    currency: "INR",
    name: "<%= list.title %>",
    description: "Booking Payment",
    order_id: "<%= order.id %>",

    theme: {
      color: "#28a745"
    },

    handler: function (response) {
      // ✅ After successful payment
      window.location.href = "/payment-success?listingId=<%= list._id %>&checkIn=<%= checkIn %>&checkOut=<%= checkOut %>&guests=<%= guests %>";
    }
  };

  const rzp = new Razorpay(options);

  document.getElementById("payBtn").onclick = function () {
    rzp.open();
  };
</script>