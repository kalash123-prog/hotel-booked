<%layout("/boilerolate/boilerplate.ejs")%>

<!-- Hero Section -->
<div style="background: linear-gradient(135deg, #1a365d 0%, #2d5a7b 100%); color: white; padding: 4rem 2rem; border-radius: 0.5rem; margin-bottom: 3rem; text-align: center;">
  <h1 style="font-size: 2.8rem; font-weight: 700; margin-bottom: 0.75rem; letter-spacing: -0.5px;">
    Discover Your Perfect Stay
  </h1>
  <p style="font-size: 1.2rem; opacity: 0.95; margin: 0;">
    Explore unique accommodations across India from mountains to beaches
  </p>
</div>

<!-- Filter Categories -->
<div class="filters">
  <form action="/listing/category" method="POST">
    <input type="hidden" name="category" value="Rooms">
    <div class="filter1">
      <button type="submit">
        <i class="fa-solid fa-bed"></i>
        <p>Rooms</p>
      </button>
    </div>
  </form>

  <form action="/listing/category" method="POST">
    <input type="hidden" name="category" value="Mountains">
    <div class="filter1">
      <button type="submit">
        <i class="fa-solid fa-mountain"></i>
        <p>Mountains</p>
      </button>
    </div>
  </form>

  <form action="/listing/category" method="POST">
    <input type="hidden" name="category" value="Camping">
    <div class="filter1">
      <button type="submit">
        <i class="fa-solid fa-tent"></i>
        <p>Camping</p>
      </button>
    </div>
  </form>

  <form action="/listing/category" method="POST">
    <input type="hidden" name="category" value="Farms">
    <div class="filter1">
      <button type="submit">
        <i class="fa-solid fa-tree"></i>
        <p>Farms</p>
      </button>
    </div>
  </form>
</div>

<!-- Listings Grid -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4 mt-2">
  <% if(listings && listings.length > 0) { %>
    <% for(let listing of listings) { %>
      <div class="col">
        <a href="/listing/<%=listing._id%>" class="cardnew">
          <img src="<%=listing.image.url%>" class="card-img-top" alt="<%=listing.title%>">
          <div class="card-body">
            <h5 class="card-title" title="<%=listing.title%>">
              <%= listing.title.length > 25 ? listing.title.substring(0, 25) + '...' : listing.title %>
            </h5>
            
            <p class="card-text text-muted" style="font-size: 0.85rem; min-height: 40px;">
              <i class="fa-solid fa-location-dot me-1"></i>
              <%= listing.location ? (listing.location.length > 40 ? listing.location.substring(0, 40) + '...' : listing.location) : 'Unknown' %>
            </p>
            
            <div class="d-flex justify-content-between align-items-center">
              <span class="price-tag">
                ₹<%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %>/night
              </span>
              <span class="badge bg-primary">
                <i class="fa-solid fa-star me-1"></i>4.8
              </span>
            </div>
            
            <% if(listing.category) { %>
              <div style="margin-top: 0.75rem;">
                <span class="badge bg-light text-dark">
                  <%= listing.category %>
                </span>
              </div>
            <% } %>
          </div>
        </a>
      </div>
    <% } %>
  <% } else { %>
    <div class="col-12">
      <div class="contain">
        <i class="fa-solid fa-inbox" style="font-size: 3rem; color: var(--primary-color); margin-bottom: 1rem;"></i>
        <h3>No Listings Found</h3>
        <p>Check back soon for amazing places to stay!</p>
      </div>
    </div>
  <% } %>
</div>
